# Turso Cloud Database Configuration (optional — falls back to local SQLite ravenx.db)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_super_secret_auth_token_here

# Groq LLM API Key (required for /api/ai/chat)
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated allowed CORS origins (defaults to production + localhost Vite)
CORS_ORIGINS=https://ravenx-protocol.duckdns.org,http://localhost:5173,http://127.0.0.1:5173

# Session token lifetime in days
SESSION_TTL_DAYS=7

# Optional Self-Hosted GPU Voice Cloning Worker (via Cloudflare Tunnel)
TTS_WORKER_URL=
TTS_WORKER_SECRET=
